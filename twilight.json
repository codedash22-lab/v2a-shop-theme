{
    "name": {
        "ar": "في تو ايه",
        "en": "V2A"
    },
    "description": {
        "ar": "ثيم مخصص لمتجر V2A Shop — أكواد وحسابات ألعاب رقمية، بهوية بنفسجية داكنة مستوحاة من أفضل متاجر الأكواد الرقمية العالمية.",
        "en": "Custom theme for V2A Shop — digital game codes and accounts, dark violet gaming identity inspired by leading digital key stores."
    },
    "repository": "https://github.com/codedash22-lab/v2a-shop-theme",
    "author_email": "codedash22@gmail.com",
    "support_url": "https://v2ashop.com",
    "features": [
        "fonts",
        "color",
        "breadcrumb",
        "component-fixed-products",
        "component-store-features",
        "component-testimonials"
    ],
    "settings": [
        {
            "type": "static",
            "format": "title",
            "id": "static-label-header",
            "value": "<div style='background:#171727;padding:14px;border-radius:8px;margin-bottom:16px;'><h6 style='color:#4ADE80;font-weight:bold;'>خيارات الهيدر</h6></div>"
        },
        {
            "id": "header_is_sticky",
            "label": "تثبيت القائمة الرئيسية أعلى الصفحة عند التمرير",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        },
        {
            "id": "show_rating_bar",
            "label": "إظهار شريط التقييم تحت الهيدر",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        },
        {
            "id": "important_links",
            "label": "عرض روابط الصفحات الهامة في الشريط العلوي",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        },
        {
            "type": "static",
            "format": "title",
            "id": "static-label-product",
            "value": "<div style='background:#171727;padding:14px;border-radius:8px;margin-bottom:16px;'><h6 style='color:#4ADE80;font-weight:bold;'>خيارات صفحة المنتج</h6></div>"
        },
        {
            "id": "product_show_breadcrumbs",
            "label": "عرض مسار التنقل بصفحة المنتج",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        },
        {
            "id": "show_delivery_checklist",
            "label": "عرض قائمة (متوفر / يعمل بالسعودية / تسليم فوري)",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        },
        {
            "id": "sticky_buy_bar",
            "label": "زر شراء ثابت أسفل الشاشة بصفحة المنتج (جوال)",
            "type": "boolean",
            "format": "switch",
            "value": true,
            "selected": true
        }
    ],
    "components": [
        {
            "key": "V2A-hero-banner-0001",
            "title": {
                "ar": "بانر رئيسي",
                "en": "V2A Hero Banner"
            },
            "icon": "sicon-image-carousel",
            "path": "home.hero-banner",
            "is_default": true,
            "fields": [
                {
                    "type": "static",
                    "format": "description",
                    "id": "hero-note",
                    "value": "<div>بانر رئيسي بعرض كامل، رسالة واحدة واضحة لكل شريحة. المقاس المناسب للصورة: 1600×900 بكسل.</div>"
                },
                {
                    "id": "slides",
                    "type": "collection",
                    "format": "collection",
                    "required": true,
                    "minLength": 1,
                    "maxLength": 5,
                    "label": "الشرائح",
                    "item_label": "شريحة",
                    "fields": [
                        {
                            "type": "string",
                            "icon": "sicon-image",
                            "id": "slides.image",
                            "label": "صورة الخلفية",
                            "format": "image",
                            "required": true,
                            "description": "المقاس المناسب: 1600×900 بكسل",
                            "settings": { "width": 1600, "height": 900 }
                        },
                        {
                            "type": "string",
                            "icon": "sicon-format-text-alt",
                            "id": "slides.eyebrow",
                            "label": "شارة صغيرة (اسم المنتج/الفئة)",
                            "multilanguage": true,
                            "format": "text",
                            "required": false,
                            "placeholder": "EA SPORTS FC 27",
                            "maxLength": 60
                        },
                        {
                            "type": "string",
                            "icon": "sicon-typography",
                            "id": "slides.title",
                            "label": "العنوان الرئيسي",
                            "multilanguage": true,
                            "format": "text",
                            "required": true,
                            "placeholder": "فيفا 27 وصل — أرخص سعر",
                            "maxLength": 80
                        },
                        {
                            "type": "string",
                            "icon": "sicon-typography",
                            "id": "slides.description",
                            "label": "وصف مختصر",
                            "multilanguage": true,
                            "format": "textarea",
                            "required": false,
                            "maxLength": 150
                        },
                        {
                            "type": "string",
                            "icon": "sicon-format-text-alt",
                            "id": "slides.cta_text",
                            "label": "نص الزر",
                            "multilanguage": true,
                            "format": "text",
                            "required": false,
                            "placeholder": "تسوق الآن",
                            "maxLength": 30
                        },
                        {
                            "type": "string",
                            "icon": "sicon-link",
                            "id": "slides.url",
                            "label": "رابط الزر (الصق رابط المنتج أو التصنيف كامل)",
                            "format": "text",
                            "required": false,
                            "placeholder": "https://v2ashop.com/ar/xxxxx"
                        }
                    ]
                }
            ]
        },
        {
            "key": "V2A-budget-tiles-0001",
            "title": {
                "ar": "تسوق حسب الميزانية",
                "en": "V2A Budget Tiles"
            },
            "icon": "sicon-price-tag",
            "path": "home.budget-tiles",
            "is_default": true,
            "fields": [
                {
                    "type": "static",
                    "format": "description",
                    "id": "budget-note",
                    "value": "<div>بطاقات سعرية تربط كل مبلغ بتصنيف يعرض منتجات بهذا النطاق السعري.</div>"
                },
                {
                    "id": "heading",
                    "type": "string",
                    "format": "text",
                    "multilanguage": true,
                    "required": false,
                    "label": "عنوان القسم",
                    "value": "تسوق حسب ميزانيتك",
                    "maxLength": 60
                },
                {
                    "id": "tiles",
                    "type": "collection",
                    "format": "collection",
                    "required": true,
                    "minLength": 2,
                    "maxLength": 4,
                    "label": "البطاقات",
                    "item_label": "بطاقة",
                    "fields": [
                        {
                            "type": "string",
                            "icon": "sicon-typography",
                            "id": "tiles.amount",
                            "label": "المبلغ (يظهر كبير، مثال: 20)",
                            "format": "text",
                            "required": true,
                            "maxLength": 10
                        },
                        {
                            "type": "string",
                            "icon": "sicon-link",
                            "id": "tiles.url",
                            "label": "رابط التصنيف (الصق رابط صفحة التصنيف كامل)",
                            "format": "text",
                            "required": true,
                            "placeholder": "https://v2ashop.com/ar/xxxxx"
                        }
                    ]
                }
            ]
        },
        {
            "key": "V2A-trust-badges-0001",
            "title": {
                "ar": "شريط الثقة",
                "en": "V2A Trust Badges"
            },
            "icon": "sicon-shield-check",
            "path": "home.trust-badges",
            "is_default": true,
            "fields": []
        }
    ]
}
