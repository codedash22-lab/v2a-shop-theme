{#
| Variable       | Type       | Description                          |
|----------------|------------|----------------------------------------|
| page           | object     |                                        |
| category       | ?Category  |                                        |
| filters        | bool       | is filters allowed here or not        |
| sort_options[] | SortList[] |                                        |
| search_query   | ?string    |                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container container--breadcrumbs">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
    </div>

    {% if category %}
        <div class="container v2a-cat-head">
            <span class="v2a-eyebrow">{{ category.parent.name ?? store.name }}</span>
            <h1 class="v2a-cat-head__title">{{ category.name }}</h1>
            {% if category.description %}
                <p class="v2a-cat-head__desc">{{ category.description|raw }}</p>
            {% endif %}
        </div>
    {% endif %}

    <div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

    <div class="container container--products-list v2a-cat-layout">
        {% if filters %}
            <button class="btn--close-sm close-filters sicon-cancel hidden"></button>
            <salla-filters data-testid="store-products-filters" class="v2a-cat-filters" id="filters-menu"></salla-filters>
        {% endif %}

        <div class="v2a-cat-main">
            <div class="v2a-cat-toolbar">
                <h2 class="sr-only" id="page-main-title">{{ page.title|raw }}</h2>
                {% if filters %}
                    <a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" class="v2a-filters-trigger lg:hidden">
                        <i class="sicon-filter"></i> تصفية النتائج
                    </a>
                {% endif %}
                {% if sort_options|length %}
                    <div class="v2a-cat-sort">
                        <label for="product-filter">ترتيب حسب</label>
                        <select id="product-filter" class="v2a-select">
                            {% for sort in sort_options %}
                                <option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>

            {% hook 'product:index.items.start' %}

            <salla-products-list data-testid="store-products-list" class="v2a-products__list"
                                  source="{{ page.slug }}" source-value="{{ page.id }}"
                                  {{ filters ?'filters-Results':'' }}></salla-products-list>

            {% hook 'product:index.items.end' %}
        </div>
    </div>

    <div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
